# Backend Configuration
# Run on Windows: python -m uvicorn main:app --host 0.0.0.0 --port 8000

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ⚠️ CRITICAL: Point to RASPBERRY PI, not Windows!
# Pi IP: 192.168.1.85
# Windows IP: 192.168.1.72
# Face processor MUST be on Pi (runs face_recognition + dlib)
FACE_PROCESSOR_URL=http://192.168.1.85:8095

# Database
DATABASE_URL=sqlite:///data/backend.db
